# Private Console-only env file: do not copy Core's database/SMTP credentials.
AUTHOVA_BASE_URL=https://identity.example.com
AUTHOVA_CONSOLE_URL=https://console.example.com
AUTHOVA_VALKEY_ADDRESS=valkey.internal:6379
AUTHOVA_VALKEY_USERNAME=authova_console
AUTHOVA_VALKEY_PASSWORD_FILE=/run/authova/console-valkey.password
AUTHOVA_VALKEY_TLS=true
AUTHOVA_VALKEY_TLS_CA_FILE=/run/authova/valkey-ca.crt
AUTHOVA_VALKEY_TLS_CERT_FILE=/run/authova/console-valkey.crt
AUTHOVA_VALKEY_TLS_KEY_FILE=/run/authova/console-valkey.key
