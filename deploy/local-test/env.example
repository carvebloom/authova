# init creates .local-test/.env using these nonsecret defaults plus random secrets.
LOCAL_TEST_DATABASE_DRIVER=mysql
AUTHOVA_MODE=development
AUTHOVA_BASE_URL=http://127.0.0.1:42100
AUTHOVA_CONSOLE_URL=http://127.0.0.1:42101
AUTHOVA_CONSOLE_CORE_URL=http://core:8080
CORE_PORT=42100
CONSOLE_PORT=42101
MAILPIT_PORT=42102
# Extra HTTPS trust: mount a PEM bundle in Core AND Console using an overlay,
# then set SSL_CERT_FILE to its container path. No insecure TLS switch exists.
SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
