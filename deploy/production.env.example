# Copy outside the repository, chmod 0600, and replace every deployment value.
# Use actual HTTPS origins; the Console connects to this Core URL over HTTPS.
AUTHOVA_BASE_URL=https://identity.example.com
AUTHOVA_CONSOLE_URL=https://console.example.com
# Default: MySQL 8.4/InnoDB, exact identifier matching, verified database TLS.
AUTHOVA_DATABASE_DRIVER=mysql
AUTHOVA_DATABASE_URL=authova_runtime:REPLACE_PASSWORD@tcp(db.example.com:3306)/authova?parseTime=true&charset=utf8mb4&collation=utf8mb4_bin&tls=true
# Explicit PostgreSQL compatibility (no automatic fallback):
# AUTHOVA_DATABASE_DRIVER=postgres
# AUTHOVA_DATABASE_URL=postgres://authova_runtime:REPLACE_PASSWORD@db.example.com:5432/authova?sslmode=verify-full
AUTHOVA_DB_CONNECTIONS=64
AUTHOVA_HTTP_CONCURRENCY=1024
AUTHOVA_KDF_CONCURRENCY=4
# Named ACL user and verified TLS are mandatory in production.
AUTHOVA_VALKEY_ADDRESS=valkey.internal:6379
AUTHOVA_VALKEY_USERNAME=authova_core
AUTHOVA_VALKEY_PASSWORD_FILE=/run/authova/core-valkey.password
AUTHOVA_VALKEY_TLS=true
AUTHOVA_VALKEY_TLS_CA_FILE=/run/authova/valkey-ca.crt
# Certificate must contain the endpoint DNS SAN (or set TLS_SERVER_NAME).
AUTHOVA_VALKEY_TLS_CERT_FILE=/run/authova/core-valkey.crt
AUTHOVA_VALKEY_TLS_KEY_FILE=/run/authova/core-valkey.key
AUTHOVA_SMTP_ADDRESS=smtp.example.com:587
AUTHOVA_SMTP_USERNAME=REPLACE_USERNAME
AUTHOVA_SMTP_PASSWORD=REPLACE_PASSWORD
AUTHOVA_SMTP_FROM=identity@example.com
# Optional HTTPS adapter. Unconfigured phone delivery is explicitly unavailable.
AUTHOVA_SMS_URL=
AUTHOVA_SMS_TOKEN=

# Optional asynchronous OTLP tracing; keep collector and metrics private.
AUTHOVA_TRACE_OTLP_ENDPOINT=
AUTHOVA_TRACE_SAMPLE_RATIO=0.01
AUTHOVA_WORKER_METRICS_LISTEN=
